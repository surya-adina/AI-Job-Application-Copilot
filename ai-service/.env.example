OPENAI_API_KEY="replace_with_your_openai_api_key"
# Must be a model listed in llm/config.py PRICING_PER_MTOK, or cost is reported as null.
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajc"
# Retries for transient OpenAI errors (rate limits, timeouts, 5xx). Logged in AiRun.retries.
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=45
# Skill matching for /analyze: "llm" (default) or "verified" (adds deterministic checks; needs pgvector).
SKILL_MATCH_MODE=llm
