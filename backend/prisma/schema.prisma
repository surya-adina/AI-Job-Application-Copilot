generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  resumes      Resume[]
  jobs         Job[]
  applications Application[]
  aiRuns       AiRun[]
  agentRuns    AgentRun[]
}

model Resume {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  rawText String @db.Text

  applications Application[]
  chunks       ResumeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Job {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String?
  title     String
  jdText    String  @db.Text
  sourceUrl String?

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(SAVED)
  notes  String?           @db.Text

  analysis      Analysis?
  resumeReview  ResumeReview?
  coverLetter   CoverLetter?
  interviewPrep InterviewPrep?
  agentRuns     AgentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analysis {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  score         Float
  matchedSkills String[]
  missingSkills String[]
  strengths     String?  @db.Text
  weaknesses    String?  @db.Text
  suggestions   Json?
  evidence      Json?

  createdAt DateTime @default(now())
}

model ResumeReview {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  summary     String   @db.Text
  suggestions Json
  growthAreas String[] @default([])
  warnings    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoverLetter {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewPrep {
  id String @id @default(uuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  technicalQuestions  Json
  behavioralQuestions Json
  projectQuestions    Json
  preparationTips     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiRun {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  endpoint      String
  model         String
  promptVersion String

  tokensIn    Int @default(0)
  tokensOut   Int @default(0)
  totalTokens Int @default(0)

  estimatedCostUsd Decimal? @db.Decimal(10, 6)

  latencyMs Int @default(0)
  retries   Int @default(0)

  status    String
  errorType String?

  // Set when the call was made by an agent run step.
  agentRunId  String?
  agentRun    AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentStepId String?
  agentStep   AgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([agentRunId])
}

// The HNSW index on "embedding" is created in raw SQL
// (migration 20261021000000_skill_embedding_hnsw); Prisma cannot declare it.
// If `prisma migrate dev` generates DROP INDEX "SkillEmbedding_embedding_idx",
// delete that line from the generated migration before applying it.
model SkillEmbedding {
  id        String                 @id @default(uuid())
  skill     String                 @unique
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())
}

// Resume text split into chunks with embeddings, written by the ai-service
// for evidence search. Searches are always scoped to one resume, so they use
// an exact scan of that resume's rows rather than an HNSW index (HNSW applies
// the resumeId filter after the nearest-neighbour search and can drop results).
model ResumeChunk {
  id          String                       @id @default(uuid())
  resumeId    String
  resume      Resume                       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  text        String                       @db.Text
  startOffset Int
  endOffset   Int
  contentHash String
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  @@unique([resumeId, chunkIndex])
  @@index([resumeId])
}

enum AgentRunStatus {
  RUNNING
  AWAITING_REVIEW
  COMPLETED
  REJECTED
  FAILED
}

// One run of the cover-letter agent. The ai-service keeps the LangGraph
// checkpoint (keyed by this id) in its own database; this row is the
// user-facing record.
model AgentRun {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  task         String
  status       AgentRunStatus @default(RUNNING)
  instructions String?        @db.Text
  review       Json?
  decision     Json?
  finalText    String?        @db.Text
  error        Json?

  steps  AgentStep[]
  aiRuns AiRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

model AgentStep {
  id         String   @id @default(uuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  index     Int
  node      String
  status    String
  latencyMs Int
  detail    Json?
  error     Json?

  aiRuns AiRun[]

  createdAt DateTime @default(now())

  @@unique([agentRunId, index])
}
