DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajc"
# Used by Prisma migrations. Locally the same as DATABASE_URL; on Neon, the non-pooled URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ajc"
JWT_SECRET="replace_with_a_strong_secret"
PORT=4000
AI_SERVICE_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
# Shared secret sent to the AI service (X-Service-Token). Must match ai-service AI_SERVICE_TOKEN.
# Generate one with: openssl rand -hex 32
AI_SERVICE_TOKEN="replace_with_a_random_secret_of_at_least_32_characters"
